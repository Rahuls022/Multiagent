# Persistence Configuration (MongoDB or standard SQLite local fallback)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DATABASE=devops_swarm
SQLITE_DB_PATH=devops_swarm.db

# Primary LLM Configuration
# Providers supported: openai, gemini, groq, anthropic, nvidia, ollama, local
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=60

# Optional Provider-Specific Fallback Keys
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=

# Workspace Sandbox Root (defaults to backend/workspaces)
# WORKSPACE_ROOT=workspaces

