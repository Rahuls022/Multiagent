# Persistent Database Configuration
# If MONGODB_URL is provided, MongoDB is used; otherwise permanent local SQLite storage is used.
# MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=devops_swarm
SQLITE_DATABASE_PATH=devops_swarm.db

# Authentication Security Settings
AUTH_SECRET_KEY=devops-swarm-auth-secret-change-in-production-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# NVIDIA NIM Integration (Optional)
# Copy this file to backend/.env and set the value locally. Never commit the key.
NVIDIA_API_KEY=
# Optional. Select any NVIDIA NIM chat model available to your account.
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT_SECONDS=45
